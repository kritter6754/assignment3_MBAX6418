# Copy to .env and fill in real values. .env is git-ignored; never commit it.
# On Railway, set these as service Variables instead of using a .env file.
CLASS_API_KEY=replace-me

# Class service endpoints (see class-endpoints.txt). Do NOT use port 9000.
LLM_BASE_URL=http://example.com:9001/v1
LLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
IMAGE_BASE_URL=http://example.com:9006/v1
IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
MUSIC_BASE_URL=http://example.com:9007
MUSIC_MODEL=acestep/acestep-v15-xl-turbo
TTS_BASE_URL=http://example.com:9008/v1
TTS_MODEL=chatterbox-v3

# Where generated songs, covers and DJ clips are stored (git-ignored)
DATA_DIR=data

# Optional: require this password (HTTP Basic, any username) to use the app
APP_PASSWORD=

# Development only: fake all four services locally (no network, no credentials needed)
MOCK_SERVICES=false

# Server only (Railway sets PORT; leave unset on your own computer)
# HOST=0.0.0.0
# PORT=8080
