# Copy this file to .env (same folder) and fill in the class credentials. .env is git-ignored.
#
# Easiest setup: put the class's class-endpoints.txt in this folder; the app reads the four
# service URLs from it. Then only CLASS_API_KEY is needed here. Values in this file win over
# class-endpoints.txt. URLs work with or without a trailing /v1.
CLASS_API_KEY=replace-me

# Class service endpoints (only needed if class-endpoints.txt is not in this folder).
# Do NOT use port 9000.
LLM_BASE_URL=http://example.com:9001/v1
IMAGE_BASE_URL=http://example.com:9006/v1
MUSIC_BASE_URL=http://example.com:9007
TTS_BASE_URL=http://example.com:9008/v1

# Optional overrides. The defaults already match the class services; leave these commented out.
# LLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
# IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
# MUSIC_MODEL=acestep/acestep-v15-xl-turbo
# TTS_MODEL=chatterbox-v3

# Where generated songs, covers, playlists and DJ clips are stored (git-ignored)
DATA_DIR=data

# Web server address (defaults: open http://localhost:8000)
# PORT=8000
# HOST=127.0.0.1

# Optional: require this password (HTTP Basic, any username) to use the app
APP_PASSWORD=

# Development only: fake all four services offline (no network, no credentials needed)
MOCK_SERVICES=false
